---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { getAuthenticatedUser } from '../../lib/auth.js';
import { query } from '../../lib/db.js';

import { ensureTemplatesTable } from '../../lib/templates.js';

const user = await getAuthenticatedUser(Astro.request);
if (!user) {
  return Astro.redirect('/login');
}

await ensureTemplatesTable();

// Fetch user's bots
const botsRes = await query(
  `SELECT * FROM bots WHERE user_id = $1 ORDER BY status = 'online' DESC, created_at DESC`,
  [user.id]
);
const bots = botsRes.rows;

// Fetch active API key
const keyRes = await query(
  `SELECT key FROM api_keys WHERE user_id = $1 AND is_active = TRUE ORDER BY created_at DESC LIMIT 1`,
  [user.id]
);
const activeApiKey = keyRes.rows[0]?.key || 'mb_live_xxxxxxxxxxxxxxxx';

// Fetch saved message templates
const templatesRes = await query(
  `SELECT * FROM templates WHERE user_id = $1 ORDER BY created_at DESC`,
  [user.id]
);
const templates = templatesRes.rows;
const selectedTemplateId = Astro.url.searchParams.get('templateId') || '';
---

<DashboardLayout title="Dispatch Message & OTP" activeNav="send">
  <div class="space-y-8">
    <div>
      <h2 class="text-xl font-bold text-white">Message & OTP Dispatch Console</h2>
      <p class="text-xs text-slate-400 mt-1">Trigger single or group messages through active WhatsApp workers and preview production API code</p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <!-- Sender Form -->
      <div class="lg:col-span-7 rounded-2xl bg-slate-900/60 border border-slate-800 p-6 glass-panel space-y-6">
        <form id="dispatch-form" class="space-y-5">
          <!-- Bot Instance Selector -->
          <div>
            <label class="block text-xs font-semibold text-slate-300 mb-1.5">Route via Bot Worker Instance</label>
            <select id="send-bot" class="w-full px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-800 focus:border-indigo-500 focus:outline-none text-xs text-slate-200 font-mono">
              <option value="">⚡ Auto-Pooler (Route to fastest online bot)</option>
              {bots.map((b) => (
                <option value={b.id}>
                  {b.name} ({b.platform} · {b.status.toUpperCase()})
                </option>
              ))}
            </select>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <!-- Channel -->
            <div>
              <label class="block text-xs font-semibold text-slate-300 mb-1.5">Channel</label>
              <select id="send-channel" class="w-full px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-800 focus:border-indigo-500 focus:outline-none text-xs text-slate-200">
                <option value="whatsapp" selected>WhatsApp (Baileys Live Gateway)</option>
              </select>
            </div>

            <!-- Message Type -->
            <div>
              <label class="block text-xs font-semibold text-slate-300 mb-1.5">Message Purpose</label>
              <select id="send-type" onchange="onTypeChange()" class="w-full px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-800 focus:border-indigo-500 focus:outline-none text-xs text-slate-200">
                <option value="otp">One-Time Password (OTP)</option>
                <option value="alert">System Alert / Incident Notice</option>
                <option value="transactional">Transactional Notification</option>
                <option value="group">Group Chat Broadcast</option>
              </select>
            </div>
          </div>

          <!-- Recipient -->
          <div>
            <label class="block text-xs font-semibold text-slate-300 mb-1.5">
              Recipient Destination 
              <span class="text-slate-500 font-normal ml-1">(Phone with country code, WeChat ID, or Group Room)</span>
            </label>
            <input
              type="text"
              id="send-recipient"
              required
              placeholder="+1 650 555 0192 or wxid_99a8b"
              value="+1 650 555 0192"
              oninput="updateCodeSnippets()"
              class="w-full px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-800 focus:border-indigo-500 focus:outline-none text-xs text-slate-100 font-mono"
            />
          </div>

          <!-- Saved Message Template Selector -->
          <div>
            <div class="flex items-center justify-between mb-1.5">
              <label class="block text-xs font-semibold text-slate-300">Apply Saved Message Template</label>
              <a href="/dashboard/templates" class="text-xs text-indigo-400 hover:text-indigo-300 hover:underline">
                Manage Templates ({templates.length}) →
              </a>
            </div>
            <select
              id="template-picker"
              onchange="handleTemplateSelect()"
              class="w-full px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-800 focus:border-indigo-500 focus:outline-none text-xs text-slate-200"
            >
              <option value="">Custom Message (No Template)</option>
              {templates.map((tpl) => (
                <option
                  value={tpl.id}
                  selected={tpl.id === selectedTemplateId}
                  data-content={tpl.content}
                  data-category={tpl.category}
                >
                  [{tpl.category.toUpperCase()}] {tpl.name}
                </option>
              ))}
            </select>
          </div>

          <!-- Content Template -->
          <div>
            <div class="flex items-center justify-between mb-1.5">
              <label class="block text-xs font-semibold text-slate-300">Message Payload Content</label>
              <button
                type="button"
                onclick="insertFreshOtp()"
                class="text-xs text-indigo-400 hover:text-indigo-300 hover:underline flex items-center gap-1"
              >
                <span>⚡ Generate New OTP Code</span>
              </button>
            </div>
            <textarea
              id="send-content"
              rows="4"
              required
              oninput="updateCodeSnippets()"
              class="w-full px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-800 focus:border-indigo-500 focus:outline-none text-xs text-slate-100 font-mono leading-relaxed"
            >Your MsgBridge verification code is 492810. Valid for 5 minutes. Please do not share this passcode with anyone.</textarea>
          </div>

          <!-- Submit Button -->
          <div class="pt-2 flex items-center justify-between">
            <span class="text-xs text-slate-400">Cost: <strong class="text-indigo-300 font-mono">1 Credit</strong> per message</span>
            <button
              type="submit"
              id="send-btn"
              class="px-6 py-3 rounded-xl font-semibold text-xs bg-indigo-600 hover:bg-indigo-500 text-white shadow-lg shadow-indigo-600/30 transition-all flex items-center gap-2"
            >
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
              </svg>
              <span>Dispatch Message Now</span>
            </button>
          </div>
        </form>

        <!-- Live Server Response Details -->
        <div id="response-container" class="hidden mt-6 pt-5 border-t border-slate-800">
          <div class="flex items-center justify-between mb-2">
            <span class="text-xs font-semibold text-white">Live Dispatch Result:</span>
            <span id="response-status-badge" class="px-2 py-0.5 rounded text-[10px] font-mono font-semibold uppercase"></span>
          </div>
          <pre id="response-payload" class="p-3.5 rounded-xl bg-slate-950 border border-slate-800 font-mono text-xs text-emerald-300 overflow-x-auto leading-relaxed"></pre>
        </div>
      </div>

      <!-- Developer REST API Code Snippets (Tailored with User's Key) -->
      <div class="lg:col-span-5 rounded-2xl bg-slate-900/60 border border-slate-800 p-6 glass-panel space-y-4">
        <div class="flex items-center justify-between pb-3 border-b border-slate-800">
          <div>
            <h3 class="font-semibold text-white text-sm">Automate in Your App</h3>
            <p class="text-xs text-slate-400">Copy code snippet directly into your backend</p>
          </div>
          <button
            onclick="copyCurrentSnippet()"
            id="copy-snippet-btn"
            class="px-2.5 py-1 rounded-lg text-xs font-mono bg-slate-800 hover:bg-slate-700 text-slate-300 transition-colors flex items-center gap-1"
          >
            Copy
          </button>
        </div>

        <!-- Language Tabs -->
        <div class="flex items-center gap-2 border-b border-slate-800 pb-2">
          <button onclick="setTab('curl')" id="tab-curl" class="px-3 py-1 rounded-lg text-xs font-semibold bg-indigo-600/30 text-indigo-300 border border-indigo-500/40">cURL</button>
          <button onclick="setTab('node')" id="tab-node" class="px-3 py-1 rounded-lg text-xs font-medium text-slate-400 hover:text-white">Node.js</button>
          <button onclick="setTab('python')" id="tab-python" class="px-3 py-1 rounded-lg text-xs font-medium text-slate-400 hover:text-white">Python</button>
        </div>

        <!-- Snippet Pre -->
        <pre id="code-snippet-box" class="p-4 rounded-xl bg-slate-950 border border-slate-800/80 font-mono text-[11px] text-slate-300 overflow-x-auto leading-relaxed max-h-96"></pre>

        <div class="p-3 rounded-xl bg-indigo-950/30 border border-indigo-500/20 text-xs text-indigo-300">
          <strong class="block text-white font-medium mb-1">API Key Auth:</strong>
          Requests authenticate using your secret key via <code class="font-mono bg-slate-900 px-1 py-0.5 rounded text-amber-300">Bearer {activeApiKey.substring(0, 14)}...</code>
        </div>
      </div>
    </div>
  </div>

  <script is:inline define:vars={{ activeApiKey }}>
    let currentTab = 'curl';

    function setTab(tab) {
      currentTab = tab;
      ['curl', 'node', 'python'].forEach((t) => {
        const btn = document.getElementById(`tab-${t}`);
        if (t === tab) {
          btn.className = 'px-3 py-1 rounded-lg text-xs font-semibold bg-indigo-600/30 text-indigo-300 border border-indigo-500/40';
        } else {
          btn.className = 'px-3 py-1 rounded-lg text-xs font-medium text-slate-400 hover:text-white';
        }
      });
      updateCodeSnippets();
    }

    function onTypeChange() {
      const type = document.getElementById('send-type').value;
      const content = document.getElementById('send-content');
      if (type === 'otp') {
        insertFreshOtp();
      } else if (type === 'alert') {
        content.value = '🚨 Alert: Database replication lag exceeded 1,200ms. Operations team investigating.';
      } else if (type === 'transactional') {
        content.value = 'Payment receipt #PAY-99182 for $49.00 confirmed. Thank you for your business!';
      } else if (type === 'group') {
        content.value = 'Notice to Engineering Team: Staging environment maintenance starts at 14:00 UTC.';
      }
      updateCodeSnippets();
    }

    function handleTemplateSelect() {
      const picker = document.getElementById('template-picker');
      const selected = picker.options[picker.selectedIndex];
      if (!selected || !selected.value) return;

      let content = selected.getAttribute('data-content') || '';
      const category = selected.getAttribute('data-category');

      // Replace common placeholder variables if present
      const freshOtp = Math.floor(100000 + Math.random() * 900000);
      content = content.replace(/\{\{\s*(code|otp)\s*\}\}/gi, freshOtp);
      content = content.replace(/\{\{\s*expiry\s*\}\}/gi, '5 minutes');
      content = content.replace(/\{\{\s*name\s*\}\}/gi, 'Alex');
      content = content.replace(/\{\{\s*service\s*\}\}/gi, 'MsgBridge');
      content = content.replace(/\{\{\s*amount\s*\}\}/gi, '$49.00');

      document.getElementById('send-content').value = content;

      if (category) {
        const sendType = document.getElementById('send-type');
        if (sendType) {
          if (category === 'otp') sendType.value = 'otp';
          else if (category === 'alerts' || category === 'alert') sendType.value = 'alert';
          else if (category === 'transactional') sendType.value = 'transactional';
          else if (category === 'marketing') sendType.value = 'group';
        }
      }
      updateCodeSnippets();
    }

    function insertFreshOtp() {
      const code = Math.floor(100000 + Math.random() * 900000);
      document.getElementById('send-content').value = `Your MsgBridge verification code is ${code}. Valid for 5 minutes. Please do not share this passcode with anyone.`;
      updateCodeSnippets();
    }

    function updateCodeSnippets() {
      const recipient = document.getElementById('send-recipient').value;
      const content = document.getElementById('send-content').value.replace(/"/g, '\\"').replace(/\n/g, ' ');
      const type = document.getElementById('send-type').value;
      const botId = document.getElementById('send-bot').value;
      const origin = window.location.origin;

      const box = document.getElementById('code-snippet-box');

      if (currentTab === 'curl') {
        box.textContent = `curl -X POST "${origin}/api/v1/messages/send" \\
  -H "Authorization: Bearer ${activeApiKey}" \\
  -H "Content-Type: application/json" \\
  -d '{
    "recipient": "${recipient}",
    "message": "${content}",
    "type": "${type}"${botId ? `,\n    "botId": "${botId}"` : ''}
  }'`;
      } else if (currentTab === 'node') {
        box.textContent = `const response = await fetch('${origin}/api/v1/messages/send', {
  method: 'POST',
  headers: {
    'Authorization': 'Bearer ${activeApiKey}',
    'Content-Type': 'application/json'
  },
  body: JSON.stringify({
    recipient: '${recipient}',
    message: '${content}',
    type: '${type}'${botId ? `,\n    botId: '${botId}'` : ''}
  })
});

const data = await response.json();
console.log('Dispatched Message ID:', data.messageId);`;
      } else if (currentTab === 'python') {
        box.textContent = `import requests

url = "${origin}/api/v1/messages/send"
headers = {
    "Authorization": "Bearer ${activeApiKey}",
    "Content-Type": "application/json"
}
payload = {
    "recipient": "${recipient}",
    "message": "${content}",
    "type": "${type}"${botId ? `,\n    "botId": "${botId}"` : ''}
}

response = requests.post(url, headers=headers, json=payload)
print(response.json())`;
      }
    }

    function copyCurrentSnippet() {
      const code = document.getElementById('code-snippet-box').textContent;
      navigator.clipboard.writeText(code);
      const btn = document.getElementById('copy-snippet-btn');
      btn.textContent = '✓ Copied';
      setTimeout(() => (btn.textContent = 'Copy'), 2000);
      window.showToast?.('Code snippet copied to clipboard!', 'success');
    }

    document.getElementById('dispatch-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      const recipient = document.getElementById('send-recipient').value;
      const content = document.getElementById('send-content').value;
      const type = document.getElementById('send-type').value;
      const botId = document.getElementById('send-bot').value || null;
      const channel = document.getElementById('send-channel').value;
      const sendBtn = document.getElementById('send-btn');
      const responseContainer = document.getElementById('response-container');
      const responsePayload = document.getElementById('response-payload');
      const statusBadge = document.getElementById('response-status-badge');

      sendBtn.disabled = true;
      sendBtn.innerHTML = `<span>Dispatching to WhatsApp Gateway...</span>`;

      try {
        const res = await fetch('/api/v1/messages/send', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ recipient, message: content, type, botId, channel })
        });

        const data = await res.json();
        responseContainer.classList.remove('hidden');
        responsePayload.textContent = JSON.stringify(data, null, 2);

        if (res.ok) {
          statusBadge.className = 'px-2 py-0.5 rounded text-[10px] font-mono font-semibold uppercase bg-emerald-500/20 text-emerald-300 border border-emerald-500/30';
          statusBadge.textContent = 'DELIVERED · 200 OK';
          window.showToast?.(`Message delivered successfully! ID: ${data.messageId}`, 'success');
        } else {
          statusBadge.className = 'px-2 py-0.5 rounded text-[10px] font-mono font-semibold uppercase bg-rose-500/20 text-rose-300 border border-rose-500/30';
          statusBadge.textContent = `ERROR ${res.status}`;
          window.showToast?.(data.error || 'Dispatch error', 'error');
        }
      } catch (err) {
        responseContainer.classList.remove('hidden');
        responsePayload.textContent = JSON.stringify({ error: err.message }, null, 2);
        statusBadge.className = 'px-2 py-0.5 rounded text-[10px] font-mono font-semibold uppercase bg-rose-500/20 text-rose-300 border border-rose-500/30';
        statusBadge.textContent = 'NETWORK FAILURE';
      } finally {
        sendBtn.disabled = false;
        sendBtn.innerHTML = `<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" /></svg><span>Dispatch Message Now</span>`;
      }
    });

    // Initialize snippet on load
    if (document.getElementById('template-picker')?.value) {
      handleTemplateSelect();
    } else {
      updateCodeSnippets();
    }
  </script>
</DashboardLayout>
