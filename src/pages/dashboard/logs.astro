---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { getAuthenticatedUser } from '../../lib/auth.js';
import { query } from '../../lib/db.js';

const user = await getAuthenticatedUser(Astro.request);
if (!user) {
  return Astro.redirect('/login');
}

// Fetch all messages for this user
const msgsRes = await query(
  `SELECT m.*, b.name as bot_name
   FROM messages m
   LEFT JOIN bots b ON m.bot_id = b.id
   WHERE m.user_id = $1
   ORDER BY m.created_at DESC
   LIMIT 100`,
  [user.id]
);
const messages = msgsRes.rows;

// Stats summary
const deliveredCount = messages.filter(m => m.status === 'delivered').length;
const failedCount = messages.filter(m => m.status === 'failed').length;
---

<DashboardLayout title="Message Delivery Logs" activeNav="logs">
  <div class="space-y-6">
    <!-- Header with Stats -->
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
      <div>
        <h2 class="text-xl font-bold text-white">Message & OTP Delivery Audit Logs</h2>
        <p class="text-xs text-slate-400 mt-1">Real-time status tracking for outbound and inbound messages</p>
      </div>

      <div class="flex items-center gap-3">
        <div class="flex items-center gap-4 px-4 py-2 rounded-xl bg-slate-900 border border-slate-800 text-xs">
          <div>
            <span class="text-slate-400">Total: </span>
            <strong class="text-white font-mono">{messages.length}</strong>
          </div>
          <div class="w-px h-4 bg-slate-800"></div>
          <div>
            <span class="text-emerald-400">Delivered: </span>
            <strong class="text-emerald-300 font-mono">{deliveredCount}</strong>
          </div>
          <div class="w-px h-4 bg-slate-800"></div>
          <div>
            <span class="text-rose-400">Failed: </span>
            <strong class="text-rose-300 font-mono">{failedCount}</strong>
          </div>
        </div>

        <button
          onclick="window.location.reload()"
          class="p-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 transition-colors"
          title="Refresh"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Filters & Search Bar -->
    <div class="p-4 rounded-2xl bg-slate-900/60 border border-slate-800 glass-panel flex flex-wrap items-center justify-between gap-4">
      <div class="flex-1 min-w-[240px]">
        <input
          type="text"
          id="log-search"
          placeholder="Filter by recipient phone, WeChat ID, or message ID..."
          oninput="filterLogs()"
          class="w-full px-3.5 py-2 rounded-xl bg-slate-950 border border-slate-800 focus:border-indigo-500 focus:outline-none text-xs text-slate-100 font-mono"
        />
      </div>

      <div class="flex items-center gap-3">
        <select id="status-filter" onchange="filterLogs()" class="px-3 py-2 rounded-xl bg-slate-950 border border-slate-800 text-xs text-slate-300">
          <option value="all">All Statuses</option>
          <option value="delivered">Delivered (Success)</option>
          <option value="failed">Failed</option>
          <option value="queued">Queued</option>
        </select>

        <select id="type-filter" onchange="filterLogs()" class="px-3 py-2 rounded-xl bg-slate-950 border border-slate-800 text-xs text-slate-300">
          <option value="all">All Types</option>
          <option value="otp">OTP Codes</option>
          <option value="alert">System Alerts</option>
          <option value="transactional">Transactional</option>
          <option value="group">Group Broadcast</option>
        </select>
      </div>
    </div>

    <!-- Logs Table -->
    <div class="rounded-2xl bg-slate-900/60 border border-slate-800 overflow-hidden glass-panel">
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs" id="logs-table">
          <thead class="bg-slate-950/70 border-b border-slate-800 text-slate-400 uppercase font-mono text-[10px]">
            <tr>
              <th class="px-6 py-3.5">Message ID</th>
              <th class="px-6 py-3.5">Type & Channel</th>
              <th class="px-6 py-3.5">Recipient</th>
              <th class="px-6 py-3.5">Content Preview</th>
              <th class="px-6 py-3.5">Bot Worker</th>
              <th class="px-6 py-3.5">Status</th>
              <th class="px-6 py-3.5">Timestamp</th>
              <th class="px-6 py-3.5 text-right">Details</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-800/60 text-slate-300" id="logs-tbody">
            {messages.length === 0 ? (
              <tr>
                <td colspan="8" class="px-6 py-12 text-center text-slate-500">
                  No message history found. Try sending an OTP via the Sender tab!
                </td>
              </tr>
            ) : (
              messages.map((m) => {
                const isDelivered = m.status === 'delivered';
                const isFailed = m.status === 'failed';
                return (
                  <tr class="log-row hover:bg-slate-800/30 transition-colors" data-id={m.id} data-recipient={m.recipient} data-content={m.content} data-status={m.status} data-type={m.type}>
                    <td class="px-6 py-3.5 font-mono text-indigo-300 font-medium">{m.id}</td>
                    <td class="px-6 py-3.5">
                      <div class="flex items-center gap-1.5">
                        <span class="px-1.5 py-0.5 rounded text-[10px] uppercase font-semibold bg-slate-800 text-slate-300 border border-slate-700">{m.type}</span>
                        <span class="text-[10px] text-slate-400 capitalize">{m.channel}</span>
                      </div>
                    </td>
                    <td class="px-6 py-3.5 font-mono text-slate-200">{m.recipient}</td>
                    <td class="px-6 py-3.5 max-w-xs truncate text-slate-400 font-mono text-[11px]">{m.content}</td>
                    <td class="px-6 py-3.5 text-slate-400 text-[11px] font-mono">{m.bot_name || m.bot_id || 'Auto-Pool'}</td>
                    <td class="px-6 py-3.5">
                      <span class={`inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full text-[10px] font-semibold ${
                        isDelivered ? 'bg-emerald-500/10 text-emerald-300 border border-emerald-500/30' :
                        isFailed ? 'bg-rose-500/10 text-rose-300 border border-rose-500/30' :
                        'bg-amber-500/10 text-amber-300 border border-amber-500/30'
                      }`}>
                        <span class={`w-1.5 h-1.5 rounded-full ${isDelivered ? 'bg-emerald-400' : isFailed ? 'bg-rose-400' : 'bg-amber-400'}`}></span>
                        {m.status}
                      </span>
                    </td>
                    <td class="px-6 py-3.5 text-slate-400 text-[11px]">{new Date(m.created_at).toLocaleString()}</td>
                    <td class="px-6 py-3.5 text-right">
                      <button
                        onclick={`showDetails(${JSON.stringify(JSON.stringify(m))})`}
                        class="px-2.5 py-1 rounded-lg text-[11px] font-medium bg-slate-800 hover:bg-slate-700 text-slate-300 transition-colors"
                      >
                        Inspect
                      </button>
                    </td>
                  </tr>
                );
              })
            )}
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Detail Inspection Modal -->
  <div id="detail-modal" class="fixed inset-0 z-50 bg-black/80 backdrop-blur-sm hidden items-center justify-center p-4">
    <div class="w-full max-w-lg rounded-2xl bg-[#0e1320] border border-slate-800 p-6 shadow-2xl relative">
      <button onclick="closeDetails()" class="absolute top-4 right-4 text-slate-400 hover:text-white">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>

      <h3 class="text-lg font-bold text-white mb-1">Message Delivery Audit Inspection</h3>
      <p class="text-xs text-slate-400 mb-4" id="detail-id"></p>

      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3 text-xs">
          <div class="p-3 rounded-xl bg-slate-950 border border-slate-800">
            <span class="text-slate-400 block text-[10px] uppercase font-mono">Recipient</span>
            <strong class="text-white font-mono text-xs" id="detail-recipient"></strong>
          </div>
          <div class="p-3 rounded-xl bg-slate-950 border border-slate-800">
            <span class="text-slate-400 block text-[10px] uppercase font-mono">Status & Cost</span>
            <strong class="text-emerald-400 font-mono text-xs" id="detail-status"></strong>
          </div>
        </div>

        <div>
          <span class="text-slate-400 block text-[11px] mb-1 font-semibold">Full Message Payload:</span>
          <div class="p-3.5 rounded-xl bg-slate-950 border border-slate-800 text-slate-200 text-xs font-mono leading-relaxed" id="detail-content"></div>
        </div>

        <div>
          <span class="text-slate-400 block text-[11px] mb-1 font-semibold">Raw Diagnostic Record (JSON):</span>
          <pre class="p-3.5 rounded-xl bg-slate-950 border border-slate-800 font-mono text-[11px] text-indigo-300 overflow-x-auto max-h-48" id="detail-raw"></pre>
        </div>
      </div>
    </div>
  </div>

  <script is:inline>
    function filterLogs() {
      const search = document.getElementById('log-search').value.toLowerCase();
      const status = document.getElementById('status-filter').value;
      const type = document.getElementById('type-filter').value;
      const rows = document.querySelectorAll('.log-row');

      rows.forEach(row => {
        const id = row.getAttribute('data-id').toLowerCase();
        const recipient = row.getAttribute('data-recipient').toLowerCase();
        const content = row.getAttribute('data-content').toLowerCase();
        const rowStatus = row.getAttribute('data-status');
        const rowType = row.getAttribute('data-type');

        const matchesSearch = id.includes(search) || recipient.includes(search) || content.includes(search);
        const matchesStatus = status === 'all' || rowStatus === status;
        const matchesType = type === 'all' || rowType === type;

        if (matchesSearch && matchesStatus && matchesType) {
          row.style.display = '';
        } else {
          row.style.display = 'none';
        }
      });
    }

    function showDetails(rawJson) {
      const data = JSON.parse(rawJson);
      document.getElementById('detail-id').textContent = `ID: ${data.id} · Dispatched at ${new Date(data.created_at).toLocaleString()}`;
      document.getElementById('detail-recipient').textContent = data.recipient;
      document.getElementById('detail-status').textContent = `${data.status.toUpperCase()} (1 Credit)`;
      document.getElementById('detail-content').textContent = data.content;
      document.getElementById('detail-raw').textContent = JSON.stringify(data, null, 2);

      const modal = document.getElementById('detail-modal');
      modal.classList.remove('hidden');
      modal.classList.add('flex');
    }

    function closeDetails() {
      const modal = document.getElementById('detail-modal');
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    }
  </script>
</DashboardLayout>
