---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { getAuthenticatedUser } from '../../lib/auth.js';
import { query } from '../../lib/db.js';
import { checkUserTemplateQuota, ensureTemplatesTable } from '../../lib/templates.js';

const user = await getAuthenticatedUser(Astro.request);
if (!user) {
  return Astro.redirect('/login');
}

await ensureTemplatesTable();

// Fetch user template quota based on subscription plan
const quota = await checkUserTemplateQuota(user.id);

// Fetch user templates
const templatesRes = await query(
  `SELECT * FROM templates WHERE user_id = $1 ORDER BY created_at DESC`,
  [user.id]
);
const templates = templatesRes.rows;

const usagePercent = quota.isUnlimited
  ? 10
  : Math.min(100, Math.round((quota.currentCount / quota.maxTemplates) * 100));
---

<DashboardLayout title="Message Templates" activeNav="templates">
  <div class="space-y-8">
    <!-- Top Header & Plan Quota Widget -->
    <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-6 pb-2">
      <div>
        <h2 class="text-xl font-bold text-white">Message Templates</h2>
        <p class="text-xs text-slate-400 mt-1">
          Create reusable WhatsApp OTP, alert, and notification templates with dynamic <code class="text-indigo-300 font-mono">{"{{variables}}"}</code> tied to your plan
        </p>
      </div>

      <!-- Plan Quota Card & Action Button -->
      <div class="flex flex-wrap items-center gap-4">
        <!-- Quota Pill -->
        <div class="px-4 py-2.5 rounded-2xl bg-slate-900/80 border border-slate-800 flex items-center gap-4">
          <div class="space-y-1">
            <div class="flex items-center justify-between gap-3 text-xs">
              <span class="text-slate-400">Plan Quota:</span>
              <span class="font-bold font-mono text-slate-200">
                {quota.currentCount} / {quota.isUnlimited ? '∞' : quota.maxTemplates}
                <span class="text-[11px] font-normal text-indigo-400 ml-1">({quota.planLabel})</span>
              </span>
            </div>
            <!-- Progress Bar -->
            <div class="w-36 h-1.5 rounded-full bg-slate-800 overflow-hidden">
              <div
                class={`h-full rounded-full transition-all ${
                  usagePercent >= 100 ? 'bg-rose-500' : usagePercent >= 75 ? 'bg-amber-400' : 'bg-indigo-500'
                }`}
                style={`width: ${usagePercent}%`}
              ></div>
            </div>
          </div>

          {!quota.isUnlimited && (
            <a
              href="/dashboard/billing"
              class="px-2.5 py-1 rounded-lg text-[11px] font-semibold bg-indigo-600/20 hover:bg-indigo-600/30 text-indigo-300 border border-indigo-500/30 transition-colors"
            >
              Upgrade
            </a>
          )}
        </div>

        <button
          type="button"
          onclick="openCreateTemplateModal()"
          class="px-4 py-2.5 rounded-xl font-semibold text-xs bg-indigo-600 hover:bg-indigo-500 text-white shadow-lg shadow-indigo-600/30 transition-all flex items-center gap-2"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4" />
          </svg>
          <span>Create Template</span>
        </button>
      </div>
    </div>

    <!-- Limit Alert if user reached max quota -->
    {!quota.allowed && (
      <div class="p-4 rounded-2xl bg-amber-950/30 border border-amber-500/30 text-xs text-amber-200 flex items-center justify-between gap-4">
        <div class="flex items-center gap-3">
          <span class="text-xl">⚠️</span>
          <div>
            <strong class="font-semibold block text-amber-100">Template Limit Reached ({quota.currentCount}/{quota.maxTemplates} Templates)</strong>
            <span>Your current {quota.planLabel} allows up to {quota.maxTemplates} templates. Upgrade to Pro (25 templates) or Enterprise (Unlimited) to add more.</span>
          </div>
        </div>
        <a
          href="/dashboard/billing"
          class="px-4 py-2 rounded-xl text-xs font-semibold bg-amber-500 hover:bg-amber-400 text-slate-950 shadow-md shrink-0 transition-colors"
        >
          Upgrade Plan
        </a>
      </div>
    )}

    <!-- Templates Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {templates.length === 0 ? (
        <div class="col-span-full p-12 text-center rounded-2xl bg-slate-900/40 border border-slate-800">
          <div class="w-12 h-12 rounded-2xl bg-indigo-500/10 text-indigo-400 flex items-center justify-center mx-auto mb-4">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
          </div>
          <h3 class="text-base font-semibold text-white">No Message Templates Saved</h3>
          <p class="text-xs text-slate-400 max-w-sm mx-auto mt-1 mb-6">
            Create reusable WhatsApp templates with variables like {"{{code}}"} and {"{{name}}"} to accelerate messaging and prevent dispatch errors.
          </p>
          <button
            onclick="openCreateTemplateModal()"
            class="px-4 py-2.5 rounded-xl text-xs font-semibold bg-indigo-600 hover:bg-indigo-500 text-white shadow-lg shadow-indigo-600/30"
          >
            Create Your First Template
          </button>
        </div>
      ) : (
        templates.map((tpl) => {
          const vars = Array.isArray(tpl.variables)
            ? tpl.variables
            : typeof tpl.variables === 'string'
            ? JSON.parse(tpl.variables || '[]')
            : [];

          const categoryColors = {
            otp: 'bg-emerald-500/15 text-emerald-300 border-emerald-500/30',
            alert: 'bg-amber-500/15 text-amber-300 border-amber-500/30',
            transactional: 'bg-indigo-500/15 text-indigo-300 border-indigo-500/30',
            marketing: 'bg-violet-500/15 text-violet-300 border-violet-500/30',
          };
          const badgeClass = categoryColors[tpl.category] || categoryColors.otp;

          return (
            <div class="rounded-2xl bg-slate-900/60 border border-slate-800 p-6 glass-panel flex flex-col justify-between hover:border-slate-700 transition-all space-y-4">
              <div>
                <!-- Header -->
                <div class="flex items-center justify-between pb-3 border-b border-slate-800/80">
                  <div class="truncate mr-2">
                    <h4 class="text-sm font-semibold text-white truncate">{tpl.name}</h4>
                    <span class="text-[11px] font-mono text-slate-500">{tpl.id}</span>
                  </div>
                  <span class={`text-[10px] font-semibold uppercase px-2.5 py-0.5 rounded-full border shrink-0 ${badgeClass}`}>
                    {tpl.category}
                  </span>
                </div>

                <!-- Template Body Box -->
                <div class="mt-4 p-3.5 rounded-xl bg-slate-950/80 border border-slate-800/90 text-xs text-slate-200 font-mono leading-relaxed relative group">
                  <p class="whitespace-pre-wrap break-words">{tpl.content}</p>
                </div>

                <!-- Detected Variables Tags -->
                <div class="mt-3.5">
                  <span class="text-[11px] text-slate-400 font-semibold block mb-1.5">Detected Variables:</span>
                  <div class="flex flex-wrap gap-1.5">
                    {vars.length === 0 ? (
                      <span class="text-[11px] text-slate-500 italic">None (Static Message)</span>
                    ) : (
                      vars.map((v) => (
                        <span class="text-[10px] font-mono font-medium px-2 py-0.5 rounded-md bg-indigo-950/60 text-indigo-300 border border-indigo-500/30">
                          {"{{" + v + "}}"}
                        </span>
                      ))
                    )}
                  </div>
                </div>
              </div>

              <!-- Action Buttons -->
              <div class="pt-4 border-t border-slate-800/80 flex items-center gap-2">
                <a
                  href={`/dashboard/send?templateId=${tpl.id}`}
                  class="flex-1 py-2 px-3 rounded-xl text-xs font-semibold bg-indigo-600/20 hover:bg-indigo-600/30 border border-indigo-500/30 text-indigo-300 transition-colors flex items-center justify-center gap-1.5"
                >
                  <svg class="w-3.5 h-3.5 text-indigo-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
                  </svg>
                  <span>Use in Console</span>
                </a>

                <button
                  type="button"
                  data-template={JSON.stringify(tpl)}
                  onclick="handleEditClick(this)"
                  title="Edit Template"
                  class="p-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 transition-colors"
                >
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                  </svg>
                </button>

                <button
                  type="button"
                  data-id={tpl.id}
                  data-name={tpl.name}
                  onclick="handleDeleteClick(this)"
                  title="Delete Template"
                  class="p-2 rounded-xl bg-rose-500/10 hover:bg-rose-500/20 text-rose-400 hover:text-rose-300 border border-rose-500/30 transition-colors"
                >
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                  </svg>
                </button>
              </div>
            </div>
          );
        })
      )}
    </div>
  </div>

  <!-- Create / Edit Template Modal -->
  <div id="template-modal" class="fixed inset-0 z-50 bg-black/80 backdrop-blur-sm hidden items-center justify-center p-4">
    <div class="w-full max-w-lg rounded-2xl bg-[#0e1320] border border-slate-800 p-6 shadow-2xl relative">
      <button onclick="closeTemplateModal()" class="absolute top-4 right-4 text-slate-400 hover:text-white">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>

      <h3 class="text-lg font-bold text-white" id="modal-title">Create Message Template</h3>
      <p class="text-xs text-slate-400 mt-1" id="modal-subtitle">
        Define message text with dynamic variable placeholders like <code class="text-indigo-300 font-mono">{"{{code}}"}</code>
      </p>

      <form id="template-form" onsubmit="handleTemplateSubmit(event)" class="mt-5 space-y-4">
        <input type="hidden" id="template-edit-id" value="" />

        <div>
          <label class="block text-xs font-semibold text-slate-300 mb-1.5">Template Name</label>
          <input
            type="text"
            id="template-name"
            required
            placeholder="e.g. WhatsApp OTP Verification"
            class="w-full px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-800 focus:border-indigo-500 focus:outline-none text-xs text-slate-100"
          />
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-semibold text-slate-300 mb-1.5">Category</label>
            <select id="template-category" class="w-full px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-800 focus:border-indigo-500 focus:outline-none text-xs text-slate-200">
              <option value="otp" selected>OTP Passcode</option>
              <option value="alert">System Alert</option>
              <option value="transactional">Transactional Notice</option>
              <option value="marketing">Marketing Broadcast</option>
            </select>
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-300 mb-1.5">Target Channel</label>
            <select id="template-channel" class="w-full px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-800 focus:border-indigo-500 focus:outline-none text-xs text-slate-200">
              <option value="whatsapp" selected>WhatsApp Web</option>
            </select>
          </div>
        </div>

        <div>
          <div class="flex items-center justify-between mb-1.5">
            <label class="block text-xs font-semibold text-slate-300">Message Content Payload</label>
            <span class="text-[11px] text-slate-500">Insert variables with {"{{variable}}"}</span>
          </div>

          <!-- Quick Variable Insert Helper Pills -->
          <div class="flex flex-wrap items-center gap-1.5 mb-2">
            <span class="text-[10px] text-slate-400">Quick insert:</span>
            <button type="button" onclick="insertVariable('code')" class="text-[10px] font-mono px-2 py-0.5 rounded bg-slate-800 hover:bg-slate-700 text-indigo-300 border border-slate-700 transition-colors">+ {"{{code}}"}</button>
            <button type="button" onclick="insertVariable('expiry')" class="text-[10px] font-mono px-2 py-0.5 rounded bg-slate-800 hover:bg-slate-700 text-indigo-300 border border-slate-700 transition-colors">+ {"{{expiry}}"}</button>
            <button type="button" onclick="insertVariable('name')" class="text-[10px] font-mono px-2 py-0.5 rounded bg-slate-800 hover:bg-slate-700 text-indigo-300 border border-slate-700 transition-colors">+ {"{{name}}"}</button>
            <button type="button" onclick="insertVariable('order_id')" class="text-[10px] font-mono px-2 py-0.5 rounded bg-slate-800 hover:bg-slate-700 text-indigo-300 border border-slate-700 transition-colors">+ {"{{order_id}}"}</button>
            <button type="button" onclick="insertVariable('amount')" class="text-[10px] font-mono px-2 py-0.5 rounded bg-slate-800 hover:bg-slate-700 text-indigo-300 border border-slate-700 transition-colors">+ {"{{amount}}"}</button>
          </div>

          <textarea
            id="template-content"
            rows="4"
            required
            oninput="handleContentInput()"
            placeholder="Your verification code is {{code}}. Valid for {{expiry}} minutes."
            class="w-full px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-800 focus:border-indigo-500 focus:outline-none text-xs text-slate-100 font-mono leading-relaxed"
          ></textarea>
        </div>

        <!-- Detected Variables Display -->
        <div class="p-3 rounded-xl bg-slate-950/80 border border-slate-800/80 text-xs">
          <div class="flex items-center justify-between">
            <span class="text-slate-400 font-medium">Auto-detected Variables:</span>
            <span id="detected-vars-count" class="font-mono text-indigo-300 font-semibold">0 variables</span>
          </div>
          <div id="detected-vars-list" class="flex flex-wrap gap-1.5 mt-2">
            <span class="text-[11px] text-slate-500 italic">None</span>
          </div>
        </div>

        <div class="pt-2">
          <button
            type="submit"
            id="modal-submit-btn"
            class="w-full py-2.5 rounded-xl font-semibold text-xs bg-indigo-600 hover:bg-indigo-500 text-white shadow-lg shadow-indigo-600/30 transition-all flex items-center justify-center gap-2"
          >
            <span>Save Template</span>
          </button>
        </div>
      </form>
    </div>
  </div>

  <script is:inline>
    function openCreateTemplateModal() {
      document.getElementById('template-edit-id').value = '';
      document.getElementById('template-name').value = '';
      document.getElementById('template-category').value = 'otp';
      document.getElementById('template-content').value = 'Your verification code is {{code}}. Valid for {{expiry}} minutes. Please do not share this passcode.';
      document.getElementById('modal-title').textContent = 'Create Message Template';
      document.getElementById('modal-submit-btn').innerHTML = '<span>Create Template</span>';
      handleContentInput();

      document.getElementById('template-modal').classList.remove('hidden');
      document.getElementById('template-modal').classList.add('flex');
    }

    function openEditTemplateModal(tpl) {
      document.getElementById('template-edit-id').value = tpl.id;
      document.getElementById('template-name').value = tpl.name;
      document.getElementById('template-category').value = tpl.category || 'otp';
      document.getElementById('template-content').value = tpl.content;
      document.getElementById('modal-title').textContent = `Edit "${tpl.name}"`;
      document.getElementById('modal-submit-btn').innerHTML = '<span>Update Template</span>';
      handleContentInput();

      document.getElementById('template-modal').classList.remove('hidden');
      document.getElementById('template-modal').classList.add('flex');
    }

    function handleEditClick(btn) {
      try {
        const raw = btn.getAttribute('data-template');
        if (raw) {
          const tpl = JSON.parse(raw);
          openEditTemplateModal(tpl);
        }
      } catch (err) {
        console.error('Failed to parse template data', err);
      }
    }

    function handleDeleteClick(btn) {
      const id = btn.getAttribute('data-id');
      const name = btn.getAttribute('data-name');
      if (id) {
        deleteTemplate(id, name || 'Template');
      }
    }

    function closeTemplateModal() {
      document.getElementById('template-modal').classList.add('hidden');
      document.getElementById('template-modal').classList.remove('flex');
    }

    function insertVariable(varName) {
      const textarea = document.getElementById('template-content');
      const insertText = `{{${varName}}}`;
      const start = textarea.selectionStart;
      const end = textarea.selectionEnd;
      const val = textarea.value;

      textarea.value = val.substring(0, start) + insertText + val.substring(end);
      textarea.focus();
      textarea.selectionStart = textarea.selectionEnd = start + insertText.length;
      handleContentInput();
    }

    function handleContentInput() {
      const text = document.getElementById('template-content').value;
      const matches = text.match(/\{\{([a-zA-Z0-9_-]+)\}\}/g) || [];
      const vars = [...new Set(matches.map(m => m.replace(/[\{\}]/g, '').trim()))];

      const countEl = document.getElementById('detected-vars-count');
      const listEl = document.getElementById('detected-vars-list');

      countEl.textContent = `${vars.length} variable${vars.length === 1 ? '' : 's'}`;

      if (vars.length === 0) {
        listEl.innerHTML = '<span class="text-[11px] text-slate-500 italic">None</span>';
      } else {
        listEl.innerHTML = vars.map(v => `
          <span class="text-[10px] font-mono font-medium px-2 py-0.5 rounded-md bg-indigo-950 text-indigo-300 border border-indigo-500/40">
            {{${v}}}
          </span>
        `).join('');
      }
    }

    async function handleTemplateSubmit(e) {
      e.preventDefault();
      const editId = document.getElementById('template-edit-id').value;
      const name = document.getElementById('template-name').value;
      const category = document.getElementById('template-category').value;
      const content = document.getElementById('template-content').value;
      const channel = document.getElementById('template-channel').value;
      const submitBtn = document.getElementById('modal-submit-btn');

      submitBtn.disabled = true;
      submitBtn.innerHTML = '<span>Saving...</span>';

      const isEdit = Boolean(editId);
      const url = isEdit ? `/api/v1/templates/${editId}` : '/api/v1/templates';
      const method = isEdit ? 'PUT' : 'POST';

      try {
        const res = await fetch(url, {
          method,
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ name, category, content, channel })
        });
        const data = await res.json();

        if (res.ok && data.success) {
          window.showToast?.(isEdit ? 'Template updated!' : 'Template created!', 'success');
          closeTemplateModal();
          setTimeout(() => window.location.reload(), 600);
        } else {
          window.showToast?.(data.error || 'Failed to save template', 'error');
        }
      } catch (err) {
        window.showToast?.(err.message || 'Error saving template', 'error');
      } finally {
        submitBtn.disabled = false;
        submitBtn.innerHTML = `<span>${isEdit ? 'Update Template' : 'Create Template'}</span>`;
      }
    }

    async function deleteTemplate(templateId, templateName) {
      if (!confirm(`Are you sure you want to delete template "${templateName}"?`)) return;

      try {
        const res = await fetch(`/api/v1/templates/${templateId}`, {
          method: 'DELETE',
          headers: { 'Content-Type': 'application/json' }
        });
        const data = await res.json();
        if (res.ok && data.success) {
          window.showToast?.('Template deleted', 'success');
          setTimeout(() => window.location.reload(), 600);
        } else {
          window.showToast?.(data.error || 'Failed to delete template', 'error');
        }
      } catch (err) {
        window.showToast?.(err.message || 'Error deleting template', 'error');
      }
    }
  </script>
</DashboardLayout>
