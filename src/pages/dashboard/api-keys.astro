---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { getAuthenticatedUser } from '../../lib/auth.js';
import { query } from '../../lib/db.js';

const user = await getAuthenticatedUser(Astro.request);
if (!user) {
  return Astro.redirect('/login');
}

// Fetch API Keys
const keysRes = await query(
  `SELECT * FROM api_keys WHERE user_id = $1 ORDER BY created_at DESC`,
  [user.id]
);
const keys = keysRes.rows;
---

<DashboardLayout title="API Keys & Access Tokens" activeNav="api-keys">
  <div class="space-y-8">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
      <div>
        <h2 class="text-xl font-bold text-white">Developer API Keys</h2>
        <p class="text-xs text-slate-400 mt-1">Authenticate REST API and webhook requests from your servers</p>
      </div>

      <button
        onclick="openCreateKeyModal()"
        class="px-4 py-2.5 rounded-xl font-semibold text-xs bg-indigo-600 hover:bg-indigo-500 text-white shadow-lg shadow-indigo-600/30 transition-all flex items-center gap-2"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4" />
        </svg>
        <span>Generate New Key</span>
      </button>
    </div>

    <!-- Security Alert -->
    <div class="p-4 rounded-2xl bg-amber-500/10 border border-amber-500/20 flex items-start gap-3 text-xs text-amber-200">
      <svg class="w-5 h-5 text-amber-400 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
      </svg>
      <div>
        <strong class="font-semibold text-white block mb-0.5">Keep your API keys confidential</strong>
        <span>MsgBridge API keys carry direct access to dispatch messages and consume your tenant credit pool. Never expose them in client-side code or public Git repositories.</span>
      </div>
    </div>

    <!-- Keys Table -->
    <div class="rounded-2xl bg-slate-900/60 border border-slate-800 overflow-hidden glass-panel">
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs">
          <thead class="bg-slate-950/70 border-b border-slate-800 text-slate-400 uppercase font-mono text-[10px]">
            <tr>
              <th class="px-6 py-3.5">Key Name</th>
              <th class="px-6 py-3.5">API Key Secret</th>
              <th class="px-6 py-3.5">Rate Limit</th>
              <th class="px-6 py-3.5">Status</th>
              <th class="px-6 py-3.5">Last Used</th>
              <th class="px-6 py-3.5">Created</th>
              <th class="px-6 py-3.5 text-right">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-800/60 text-slate-300">
            {keys.length === 0 ? (
              <tr>
                <td colspan="7" class="px-6 py-12 text-center text-slate-500">
                  No active API keys found. Generate a key to connect your application!
                </td>
              </tr>
            ) : (
              keys.map((k) => (
                <tr class="hover:bg-slate-800/30 transition-colors">
                  <td class="px-6 py-4 font-semibold text-white">{k.name}</td>
                  <td class="px-6 py-4 font-mono text-indigo-300">
                    <div class="flex items-center gap-2">
                      <span>{k.key.substring(0, 10)}••••••••••••{k.key.substring(k.key.length - 4)}</span>
                      <button
                        onclick={`copyApiKey('${k.key}')`}
                        title="Copy raw key"
                        class="p-1 rounded hover:bg-slate-800 text-slate-400 hover:text-indigo-300 transition-colors"
                      >
                        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                        </svg>
                      </button>
                    </div>
                  </td>
                  <td class="px-6 py-4 font-mono text-slate-300">{k.rate_limit_per_min} req/min</td>
                  <td class="px-6 py-4">
                    <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full text-[10px] font-semibold bg-emerald-500/10 text-emerald-300 border border-emerald-500/30">
                      <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                      Active
                    </span>
                  </td>
                  <td class="px-6 py-4 text-slate-400 text-[11px]">
                    {k.last_used_at ? new Date(k.last_used_at).toLocaleString() : 'Never'}
                  </td>
                  <td class="px-6 py-4 text-slate-400 text-[11px]">
                    {new Date(k.created_at).toLocaleDateString()}
                  </td>
                  <td class="px-6 py-4 text-right">
                    <button
                      onclick={`revokeKey('${k.id}')`}
                      class="px-2.5 py-1 rounded-lg text-[11px] font-medium text-rose-400 hover:bg-rose-500/10 border border-transparent hover:border-rose-500/30 transition-colors"
                    >
                      Revoke
                    </button>
                  </td>
                </tr>
              ))
            )}
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Generate Key Modal -->
  <div id="key-modal" class="fixed inset-0 z-50 bg-black/80 backdrop-blur-sm hidden items-center justify-center p-4">
    <div class="w-full max-w-md rounded-2xl bg-[#0e1320] border border-slate-800 p-6 shadow-2xl relative">
      <button onclick="closeCreateKeyModal()" class="absolute top-4 right-4 text-slate-400 hover:text-white">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>

      <h3 class="text-lg font-bold text-white">Generate Live API Key</h3>
      <p class="text-xs text-slate-400 mt-1">Create a token to authenticate HTTP API requests</p>

      <form id="create-key-form" class="mt-6 space-y-4">
        <div>
          <label class="block text-xs font-semibold text-slate-300 mb-1.5">Key Name / Environment</label>
          <input
            type="text"
            id="key-name-input"
            required
            placeholder="e.g. Staging Backend Webhook"
            class="w-full px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-800 focus:border-indigo-500 focus:outline-none text-xs text-slate-100"
          />
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-300 mb-1.5">Rate Limit (Requests / Minute)</label>
          <select id="key-rate-limit" class="w-full px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-800 focus:border-indigo-500 focus:outline-none text-xs text-slate-200">
            <option value="60">60 requests / min (Standard)</option>
            <option value="120">120 requests / min (High Throughput)</option>
            <option value="300">300 requests / min (Cluster Burst)</option>
          </select>
        </div>

        <div class="pt-2">
          <button
            type="submit"
            id="create-key-btn"
            class="w-full py-2.5 rounded-xl font-semibold text-xs bg-indigo-600 hover:bg-indigo-500 text-white shadow-lg shadow-indigo-600/30 transition-all"
          >
            Generate Key
          </button>
        </div>
      </form>
    </div>
  </div>

  <script is:inline>
    function openCreateKeyModal() {
      document.getElementById('key-modal').classList.remove('hidden');
      document.getElementById('key-modal').classList.add('flex');
    }

    function closeCreateKeyModal() {
      document.getElementById('key-modal').classList.add('hidden');
      document.getElementById('key-modal').classList.remove('flex');
    }

    function copyApiKey(key) {
      navigator.clipboard.writeText(key);
      window.showToast?.('Full API key copied to clipboard!', 'success');
    }

    async function revokeKey(keyId) {
      if (!confirm('Are you sure you want to permanently revoke this API key? Applications using it will immediately fail to authenticate.')) {
        return;
      }

      try {
        const res = await fetch(`/api/v1/api-keys?id=${keyId}`, { method: 'DELETE' });
        const data = await res.json();
        if (data.success) {
          window.showToast?.('API key revoked successfully', 'success');
          setTimeout(() => window.location.reload(), 600);
        } else {
          window.showToast?.(data.error || 'Failed to revoke key', 'error');
        }
      } catch (e) {
        window.showToast?.(e.message, 'error');
      }
    }

    document.getElementById('create-key-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      const name = document.getElementById('key-name-input').value;
      const rateLimit = document.getElementById('key-rate-limit').value;
      const btn = document.getElementById('create-key-btn');

      btn.disabled = true;
      btn.textContent = 'Generating...';

      try {
        const res = await fetch('/api/v1/api-keys', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ name, rateLimit })
        });
        const data = await res.json();
        if (data.success) {
          window.showToast?.('New API key generated!', 'success');
          closeCreateKeyModal();
          setTimeout(() => window.location.reload(), 600);
        } else {
          window.showToast?.(data.error || 'Failed to create key', 'error');
        }
      } catch (err) {
        window.showToast?.(err.message, 'error');
      } finally {
        btn.disabled = false;
        btn.textContent = 'Generate Key';
      }
    });
  </script>
</DashboardLayout>
