---
import MainLayout from '../layouts/MainLayout.astro';
import { getAuthenticatedUser } from '../lib/auth.js';

const user = await getAuthenticatedUser(Astro.request);
if (user) {
  return Astro.redirect('/dashboard');
}
---

<MainLayout title="Sign In | MsgBridge SaaS Hub">
  <div class="min-h-screen flex items-center justify-center p-6 bg-[#07090e] relative overflow-hidden">
    <!-- Ambient glow -->
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[300px] bg-indigo-600/15 rounded-full blur-[120px] pointer-events-none"></div>

    <div class="w-full max-w-md relative z-10">
      <!-- Logo -->
      <div class="text-center mb-8">
        <a href="/" class="inline-flex items-center gap-2.5 mb-3 group">
          <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-indigo-600 to-violet-500 flex items-center justify-center shadow-lg shadow-indigo-500/20 group-hover:scale-105 transition-transform">
            <svg class="w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
            </svg>
          </div>
          <span class="font-bold text-2xl tracking-tight text-white">MsgBridge</span>
        </a>
        <h2 class="text-xl font-bold text-slate-100">Welcome Back</h2>
        <p class="text-xs text-slate-400 mt-1">Sign in to manage your Wechaty bot pool & API keys</p>
      </div>

      <!-- Login Form Card -->
      <div class="p-8 rounded-2xl bg-slate-900/70 border border-slate-800 backdrop-blur shadow-2xl space-y-6">
        <!-- Quick Demo Fill Buttons -->
        <div class="space-y-2">
          <span class="text-[11px] font-semibold text-slate-400 uppercase tracking-wider block">1-Click Quick Demo Sign In</span>
          <div class="grid grid-cols-2 gap-2">
            <button
              type="button"
              onclick="fillDemo('developer@company.com', 'developer123')"
              class="px-3 py-2 rounded-xl text-xs font-semibold bg-indigo-500/10 hover:bg-indigo-500/20 border border-indigo-500/30 text-indigo-300 transition-colors text-left"
            >
              <span class="block font-bold">Developer Demo</span>
              <span class="text-[10px] text-slate-400">Tenant with Bot & Keys</span>
            </button>
            <button
              type="button"
              onclick="fillDemo('admin@msgbridge.io', 'admin123456')"
              class="px-3 py-2 rounded-xl text-xs font-semibold bg-amber-500/10 hover:bg-amber-500/20 border border-amber-500/30 text-amber-300 transition-colors text-left"
            >
              <span class="block font-bold">Admin Demo</span>
              <span class="text-[10px] text-slate-400">Full Cluster Control</span>
            </button>
          </div>
        </div>

        <div class="relative flex items-center justify-center">
          <div class="border-t border-slate-800 w-full"></div>
          <span class="bg-[#0f1422] px-3 text-[11px] text-slate-500 uppercase tracking-wider absolute">or enter details</span>
        </div>

        <form id="login-form" class="space-y-4">
          <div>
            <label class="block text-xs font-semibold text-slate-300 mb-1.5">Email Address</label>
            <input
              type="email"
              id="login-email"
              required
              placeholder="name@company.com"
              class="w-full px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-800 focus:border-indigo-500 focus:outline-none text-sm text-slate-100 placeholder:text-slate-600 transition-colors"
            />
          </div>

          <div>
            <div class="flex items-center justify-between mb-1.5">
              <label class="block text-xs font-semibold text-slate-300">Password</label>
            </div>
            <input
              type="password"
              id="login-password"
              required
              placeholder="••••••••"
              class="w-full px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-800 focus:border-indigo-500 focus:outline-none text-sm text-slate-100 placeholder:text-slate-600 transition-colors"
            />
          </div>

          <div id="login-error" class="hidden p-3 rounded-xl bg-rose-950/50 border border-rose-500/30 text-xs text-rose-300"></div>

          <button
            type="submit"
            id="login-btn"
            class="w-full py-3 rounded-xl font-semibold text-xs bg-indigo-600 hover:bg-indigo-500 text-white shadow-lg shadow-indigo-600/30 transition-all flex items-center justify-center gap-2"
          >
            <span>Sign In to Console</span>
          </button>
        </form>

        <div class="text-center pt-2">
          <p class="text-xs text-slate-400">
            Don't have an account yet? 
            <a href="/register" class="text-indigo-400 hover:underline font-semibold ml-1">Create an account</a>
          </p>
        </div>
      </div>
    </div>
  </div>

  <script is:inline>
    function fillDemo(email, pass) {
      document.getElementById('login-email').value = email;
      document.getElementById('login-password').value = pass;
      document.getElementById('login-form').dispatchEvent(new Event('submit'));
    }

    document.getElementById('login-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = document.getElementById('login-email').value;
      const password = document.getElementById('login-password').value;
      const errorDiv = document.getElementById('login-error');
      const submitBtn = document.getElementById('login-btn');

      errorDiv.classList.add('hidden');
      submitBtn.disabled = true;
      submitBtn.innerHTML = `<span>Signing in...</span>`;

      try {
        const res = await fetch('/api/v1/auth/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, password }),
        });

        const data = await res.json();
        if (!res.ok) {
          errorDiv.textContent = data.error || 'Authentication failed';
          errorDiv.classList.remove('hidden');
          submitBtn.disabled = false;
          submitBtn.innerHTML = `<span>Sign In to Console</span>`;
          return;
        }

        window.showToast?.('Signed in successfully!', 'success');
        if (data.user?.role === 'admin') {
          window.location.href = '/admin';
        } else {
          window.location.href = '/dashboard';
        }
      } catch (err) {
        errorDiv.textContent = err.message || 'Network error';
        errorDiv.classList.remove('hidden');
        submitBtn.disabled = false;
        submitBtn.innerHTML = `<span>Sign In to Console</span>`;
      }
    });
  </script>
</MainLayout>
