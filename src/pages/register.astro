---
import MainLayout from '../layouts/MainLayout.astro';
import { getAuthenticatedUser } from '../lib/auth.js';

const user = await getAuthenticatedUser(Astro.request);
if (user) {
  return Astro.redirect('/dashboard');
}
---

<MainLayout title="Create Account | MsgBridge SaaS Hub">
  <div class="min-h-screen flex items-center justify-center p-6 bg-[#07090e] relative overflow-hidden">
    <!-- Ambient glow -->
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[300px] bg-indigo-600/15 rounded-full blur-[120px] pointer-events-none"></div>

    <div class="w-full max-w-md relative z-10">
      <!-- Logo -->
      <div class="text-center mb-8">
        <a href="/" class="inline-flex items-center gap-2.5 mb-3 group">
          <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-indigo-600 to-violet-500 flex items-center justify-center shadow-lg shadow-indigo-500/20 group-hover:scale-105 transition-transform">
            <svg class="w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
            </svg>
          </div>
          <span class="font-bold text-2xl tracking-tight text-white">MsgBridge</span>
        </a>
        <h2 class="text-xl font-bold text-slate-100">Create Developer Account</h2>
        <p class="text-xs text-slate-400 mt-1">Includes 1,000 free credits and instant bot instance setup</p>
      </div>

      <!-- Register Form Card -->
      <div class="p-8 rounded-2xl bg-slate-900/70 border border-slate-800 backdrop-blur shadow-2xl space-y-6">
        <form id="register-form" class="space-y-4">
          <div>
            <label class="block text-xs font-semibold text-slate-300 mb-1.5">Full Name / Organization</label>
            <input
              type="text"
              id="reg-name"
              required
              placeholder="e.g. Alex Rivers"
              class="w-full px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-800 focus:border-indigo-500 focus:outline-none text-sm text-slate-100 placeholder:text-slate-600 transition-colors"
            />
          </div>

          <div>
            <label class="block text-xs font-semibold text-slate-300 mb-1.5">Work Email Address</label>
            <input
              type="email"
              id="reg-email"
              required
              placeholder="developer@company.com"
              class="w-full px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-800 focus:border-indigo-500 focus:outline-none text-sm text-slate-100 placeholder:text-slate-600 transition-colors"
            />
          </div>

          <div>
            <label class="block text-xs font-semibold text-slate-300 mb-1.5">Password (min 6 characters)</label>
            <input
              type="password"
              id="reg-password"
              required
              minlength="6"
              placeholder="••••••••"
              class="w-full px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-800 focus:border-indigo-500 focus:outline-none text-sm text-slate-100 placeholder:text-slate-600 transition-colors"
            />
          </div>

          <div id="register-error" class="hidden p-3 rounded-xl bg-rose-950/50 border border-rose-500/30 text-xs text-rose-300"></div>

          <button
            type="submit"
            id="reg-btn"
            class="w-full py-3 rounded-xl font-semibold text-xs bg-indigo-600 hover:bg-indigo-500 text-white shadow-lg shadow-indigo-600/30 transition-all flex items-center justify-center gap-2"
          >
            <span>Create Sandbox Account</span>
          </button>
        </form>

        <div class="text-center pt-2">
          <p class="text-xs text-slate-400">
            Already have an account? 
            <a href="/login" class="text-indigo-400 hover:underline font-semibold ml-1">Sign in here</a>
          </p>
        </div>
      </div>
    </div>
  </div>

  <script is:inline>
    document.getElementById('register-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      const name = document.getElementById('reg-name').value;
      const email = document.getElementById('reg-email').value;
      const password = document.getElementById('reg-password').value;
      const errorDiv = document.getElementById('register-error');
      const submitBtn = document.getElementById('reg-btn');

      errorDiv.classList.add('hidden');
      submitBtn.disabled = true;
      submitBtn.innerHTML = `<span>Provisioning account...</span>`;

      try {
        const res = await fetch('/api/v1/auth/register', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ name, email, password }),
        });

        const data = await res.json();
        if (!res.ok) {
          errorDiv.textContent = data.error || 'Registration failed';
          errorDiv.classList.remove('hidden');
          submitBtn.disabled = false;
          submitBtn.innerHTML = `<span>Create Sandbox Account</span>`;
          return;
        }

        window.showToast?.('Account created with 1,000 Free Credits!', 'success');
        window.location.href = '/dashboard';
      } catch (err) {
        errorDiv.textContent = err.message || 'Network error';
        errorDiv.classList.remove('hidden');
        submitBtn.disabled = false;
        submitBtn.innerHTML = `<span>Create Sandbox Account</span>`;
      }
    });
  </script>
</MainLayout>
