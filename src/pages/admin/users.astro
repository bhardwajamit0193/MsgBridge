---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getAuthenticatedUser } from '../../lib/auth.js';
import { query } from '../../lib/db.js';

const user = await getAuthenticatedUser(Astro.request);
if (!user || user.role !== 'admin') {
  return Astro.redirect('/dashboard');
}

// Fetch all tenants with statistics
const usersRes = await query(`
  SELECT 
    u.id, u.email, u.name, u.role, u.plan, u.credits, u.created_at,
    (SELECT COUNT(*) FROM api_keys k WHERE k.user_id = u.id) as key_count,
    (SELECT COUNT(*) FROM bots b WHERE b.user_id = u.id) as bot_count,
    (SELECT COUNT(*) FROM messages m WHERE m.user_id = u.id) as message_count
  FROM users u
  ORDER BY u.created_at DESC
`);
const tenants = usersRes.rows;
---

<AdminLayout title="Tenant & User Management" activeNav="users">
  <div class="space-y-6">
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
      <div>
        <h2 class="text-xl font-bold text-white">Multi-Tenant User Management</h2>
        <p class="text-xs text-slate-400 mt-1">Audit tenant API usage, allocate message credits, and modify subscription tiers</p>
      </div>

      <div class="text-xs text-slate-400">
        Total Registered: <strong class="text-white font-mono">{tenants.length} Tenants</strong>
      </div>
    </div>

    <!-- Tenants Table -->
    <div class="rounded-2xl bg-slate-900/60 border border-slate-800 overflow-hidden glass-panel">
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs">
          <thead class="bg-slate-950/70 border-b border-slate-800 text-slate-400 uppercase font-mono text-[10px]">
            <tr>
              <th class="px-6 py-3.5">Tenant / User</th>
              <th class="px-6 py-3.5">Role</th>
              <th class="px-6 py-3.5">Plan Tier</th>
              <th class="px-6 py-3.5">Credits Balance</th>
              <th class="px-6 py-3.5">Bots Active</th>
              <th class="px-6 py-3.5">API Keys</th>
              <th class="px-6 py-3.5">Messages Sent</th>
              <th class="px-6 py-3.5">Registered</th>
              <th class="px-6 py-3.5 text-right">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-800/60 text-slate-300">
            {tenants.map((t) => (
              <tr class="hover:bg-slate-800/30 transition-colors">
                <td class="px-6 py-4">
                  <div class="font-semibold text-white">{t.name}</div>
                  <div class="text-[11px] text-slate-400 font-mono">{t.email}</div>
                </td>
                <td class="px-6 py-4">
                  <span class={`px-2 py-0.5 rounded text-[10px] uppercase font-bold ${
                    t.role === 'admin'
                      ? 'bg-amber-500/20 text-amber-300 border border-amber-500/30'
                      : 'bg-slate-800 text-slate-300 border border-slate-700'
                  }`}>
                    {t.role}
                  </span>
                </td>
                <td class="px-6 py-4">
                  <span class="font-mono text-indigo-300 font-semibold uppercase text-xs">{t.plan}</span>
                </td>
                <td class="px-6 py-4 font-mono font-bold text-white text-xs">
                  {parseInt(t.credits, 10).toLocaleString()}
                </td>
                <td class="px-6 py-4 font-mono text-slate-300">{t.bot_count}</td>
                <td class="px-6 py-4 font-mono text-slate-300">{t.key_count}</td>
                <td class="px-6 py-4 font-mono text-emerald-400 font-semibold">{t.message_count}</td>
                <td class="px-6 py-4 text-slate-400 text-[11px]">{new Date(t.created_at).toLocaleDateString()}</td>
                <td class="px-6 py-4 text-right">
                  <button
                    onclick={`openEditUserModal(${JSON.stringify(JSON.stringify(t))})`}
                    class="px-2.5 py-1 rounded-lg text-xs font-semibold bg-indigo-600/20 hover:bg-indigo-600/30 border border-indigo-500/30 text-indigo-300 transition-colors"
                  >
                    Manage
                  </button>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Edit User Modal -->
  <div id="edit-user-modal" class="fixed inset-0 z-50 bg-black/80 backdrop-blur-sm hidden items-center justify-center p-4">
    <div class="w-full max-w-md rounded-2xl bg-[#0e1320] border border-slate-800 p-6 shadow-2xl relative">
      <button onclick="closeEditUserModal()" class="absolute top-4 right-4 text-slate-400 hover:text-white">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>

      <h3 class="text-lg font-bold text-white mb-0.5">Manage Tenant Account</h3>
      <p class="text-xs text-slate-400 mb-5" id="modal-tenant-info"></p>

      <form id="edit-user-form" class="space-y-4">
        <input type="hidden" id="edit-user-id" />

        <div>
          <label class="block text-xs font-semibold text-slate-300 mb-1.5">Subscription Plan Tier</label>
          <select id="edit-plan" class="w-full px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-800 focus:border-indigo-500 focus:outline-none text-xs text-slate-200">
            <option value="free">Free / Sandbox (1,000 Credits)</option>
            <option value="developer">Developer ($29/mo)</option>
            <option value="pro">Pro Cluster ($79/mo)</option>
            <option value="enterprise">Enterprise Tier ($199/mo)</option>
          </select>
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-300 mb-1.5">Available Credits Balance</label>
          <input
            type="number"
            id="edit-credits"
            required
            class="w-full px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-800 focus:border-indigo-500 focus:outline-none text-xs text-slate-100 font-mono"
          />
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-300 mb-1.5">Access Role</label>
          <select id="edit-role" class="w-full px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-800 focus:border-indigo-500 focus:outline-none text-xs text-slate-200">
            <option value="user">Standard Tenant (User)</option>
            <option value="admin">Cluster Administrator (Admin)</option>
          </select>
        </div>

        <div class="pt-3">
          <button
            type="submit"
            id="save-user-btn"
            class="w-full py-2.5 rounded-xl font-semibold text-xs bg-indigo-600 hover:bg-indigo-500 text-white shadow-lg shadow-indigo-600/30 transition-all"
          >
            Save Changes
          </button>
        </div>
      </form>
    </div>
  </div>

  <script is:inline>
    function openEditUserModal(rawJson) {
      const data = JSON.parse(rawJson);
      document.getElementById('modal-tenant-info').textContent = `${data.name} (${data.email})`;
      document.getElementById('edit-user-id').value = data.id;
      document.getElementById('edit-plan').value = data.plan;
      document.getElementById('edit-credits').value = data.credits;
      document.getElementById('edit-role').value = data.role;

      const modal = document.getElementById('edit-user-modal');
      modal.classList.remove('hidden');
      modal.classList.add('flex');
    }

    function closeEditUserModal() {
      const modal = document.getElementById('edit-user-modal');
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    }

    document.getElementById('edit-user-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      const userId = document.getElementById('edit-user-id').value;
      const plan = document.getElementById('edit-plan').value;
      const credits = document.getElementById('edit-credits').value;
      const role = document.getElementById('edit-role').value;
      const btn = document.getElementById('save-user-btn');

      btn.disabled = true;
      btn.textContent = 'Updating...';

      try {
        const res = await fetch('/api/v1/admin/users', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ userId, plan, credits, role })
        });
        const data = await res.json();
        if (data.success) {
          window.showToast?.('Tenant details updated successfully!', 'success');
          closeEditUserModal();
          setTimeout(() => window.location.reload(), 600);
        } else {
          window.showToast?.(data.error || 'Update failed', 'error');
        }
      } catch (err) {
        window.showToast?.(err.message, 'error');
      } finally {
        btn.disabled = false;
        btn.textContent = 'Save Changes';
      }
    });
  </script>
</AdminLayout>
